.head { display: flex; gap: 20rpx; align-items: center; }
.cover { width: 110rpx; height: 110rpx; border-radius: 24rpx; background: #dcfce7; color: #15803d; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; flex-shrink: 0; }
.info { flex: 1; }
.name { font-size: 32rpx; font-weight: 700; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.meta { font-size: 22rpx; color: #9ca3af; margin-top: 8rpx; }
.due { color: #b45309; }
