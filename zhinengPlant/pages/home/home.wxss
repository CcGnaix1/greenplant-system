.page{padding:0 0 70rpx;background:#f7f5ed}.hero-banner{height:600rpx;position:relative;overflow:hidden;border-radius:0 0 42rpx 42rpx}.hero-bg{position:absolute;inset:0;width:100%;height:100%}.hero-wash{position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,252,237,.96) 0%,rgba(255,249,221,.72) 42%,rgba(255,255,255,.02) 76%)}.hero-top{position:relative;z-index:2;display:flex;align-items:flex-start;justify-content:space-between;padding:34rpx 30rpx}.brand{display:flex;align-items:center;gap:14rpx;color:#174c2c;font-size:28rpx;font-weight:800;letter-spacing:2rpx}.brand-leaf{font-size:30rpx;color:#559a62;transform:rotate(45deg)}.brand-sub{font-size:15rpx;letter-spacing:3rpx;color:#7a897b;margin-top:3rpx;font-weight:400}.hero-tools{display:flex;gap:14rpx}.tool{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.82);display:flex;align-items:center;justify-content:center;font-size:34rpx;color:#24372b;box-shadow:0 8rpx 22rpx rgba(49,77,51,.12);position:relative}.notify-dot{position:absolute;width:12rpx;height:12rpx;border-radius:50%;right:7rpx;top:6rpx;background:#f36e62}.hero-slogan{position:absolute;z-index:2;left:34rpx;top:152rpx;color:#174a2b;font-size:54rpx;line-height:1.2;font-weight:900;letter-spacing:2rpx;text-shadow:0 2rpx 0 rgba(255,255,255,.5)}.heart{color:#ff8d69;font-size:44rpx;margin-left:14rpx}.task-pill{position:absolute;z-index:3;left:30rpx;bottom:68rpx;height:80rpx;min-width:430rpx;padding:0 24rpx;border-radius:999rpx;background:rgba(255,255,255,.94);display:flex;align-items:center;gap:12rpx;color:#263d2d;font-size:24rpx;box-shadow:0 12rpx 30rpx rgba(45,73,46,.13)}.sprout{color:#4b9560}.task-num{color:#ef704e;font-weight:800}.pill-arrow{font-size:38rpx;margin-left:auto}
.hero-actions{display:flex;gap:18rpx;margin:-34rpx 22rpx 36rpx;position:relative;z-index:5;padding:18rpx;border-radius:34rpx;background:rgba(255,252,244,.96);box-shadow:0 16rpx 34rpx rgba(52,75,56,.1)}.hero-action{flex:1;height:142rpx;border-radius:27rpx;color:#fff;display:flex;align-items:center;padding:0 20rpx;gap:14rpx;box-sizing:border-box}.recognize{background:linear-gradient(135deg,#619f66,#357d4c)}.water{background:linear-gradient(135deg,#f3aa72,#f08750)}.action-icon{width:62rpx;height:62rpx;border-radius:20rpx;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:40rpx;flex-shrink:0}.action-title{font-size:28rpx;font-weight:800}.action-sub{font-size:17rpx;opacity:.82;margin-top:5rpx;white-space:nowrap}.action-arrow{margin-left:auto;font-size:38rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:800;margin:24rpx 30rpx 18rpx}.section-meta{font-size:22rpx;color:#88938c;font-weight:400}.care-card{margin-left:28rpx;margin-right:28rpx;padding-top:18rpx;padding-bottom:18rpx}.care-card .row{padding:20rpx 0}.care-action,.task-complete{color:#397d50;background:#e8f3e7;padding:12rpx 20rpx;border-radius:999rpx;font-size:21rpx}.all-good{display:flex;align-items:center;gap:20rpx;padding:16rpx 4rpx}.good-check{width:66rpx;height:66rpx;background:#dff1e1;color:#3b8753;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32rpx}.good-title{font-weight:700}.good-sub{font-size:22rpx;color:var(--ink3);margin-top:5rpx}.family-task-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-top:1rpx solid #edf0eb}.task-icon{width:68rpx;height:68rpx;border-radius:20rpx;background:#e7f3e5;color:#347b4b;display:flex;align-items:center;justify-content:center}.task-main{flex:1}.task-title{font-weight:650}.task-meta{font-size:21rpx;color:var(--ink3);margin-top:5rpx}
.plant-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:0 28rpx}.plant-card{overflow:hidden;background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(47,79,57,.08)}.plant-visual{height:210rpx;background:#e8f1e3;position:relative}.plant-visual image{width:100%;height:100%}.mini-leaf{position:absolute;right:18rpx;top:15rpx;color:#7bac7d;font-size:23rpx;transform:rotate(45deg)}.plant-body{padding:20rpx}.name{font-size:28rpx;font-weight:750}.meta{font-size:20rpx;color:var(--ink3);margin-top:4rpx}.plant-bottom{font-size:21rpx;color:#438158;margin-top:14rpx}.status-dot{display:inline-block;width:12rpx;height:12rpx;border-radius:50%;background:#54a36a;margin-right:8rpx}.empty-list{text-align:center;color:var(--ink3);font-size:23rpx;padding:36rpx 0}
