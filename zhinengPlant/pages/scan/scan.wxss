.scan-page{padding:28rpx 28rpx 70rpx;background:linear-gradient(180deg,#f4f6ef 0%,#faf9f4 58%,#f5f5ee 100%);min-height:100vh;box-sizing:border-box}
.scan-hero{position:relative;overflow:hidden;border-radius:38rpx;padding:34rpx 34rpx 30rpx;background:linear-gradient(135deg,#dcefd8 0%,#c0dfbd 58%,#acd3ad 100%);box-shadow:0 18rpx 40rpx rgba(48,91,56,.12);margin-bottom:22rpx}.hero-glow{position:absolute;border-radius:50%;background:rgba(255,255,255,.24)}.glow-one{width:250rpx;height:250rpx;right:-60rpx;top:-96rpx}.glow-two{width:140rpx;height:140rpx;right:94rpx;bottom:-82rpx}.intro-tag{position:relative;display:inline-flex;align-items:center;color:#477959;background:rgba(255,255,255,.62);border-radius:999rpx;padding:8rpx 16rpx;font-size:19rpx;font-weight:600}.tag-dot{width:10rpx;height:10rpx;border-radius:50%;background:#4b9b62;margin-right:9rpx}.intro-title{position:relative;font-size:39rpx;font-weight:800;color:#213e2c;margin-top:18rpx}.intro-sub{position:relative;font-size:22rpx;color:#66806e;margin-top:8rpx}.tips{position:relative;display:flex;gap:12rpx;margin-top:24rpx}.tip{font-size:18rpx;color:#587462;background:rgba(255,255,255,.48);border-radius:999rpx;padding:8rpx 13rpx}.tip text{color:#3c8a55;margin-right:3rpx}
.capture-card,.state-card{background:rgba(255,255,255,.97);border-radius:34rpx;padding:22rpx;box-shadow:0 15rpx 38rpx rgba(44,72,51,.08);border:1rpx solid rgba(55,96,65,.07)}.capture-area{height:390rpx;border-radius:28rpx;background:linear-gradient(155deg,#f1f8ed,#e2f1e0);position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}.corner{position:absolute;width:44rpx;height:44rpx;border-color:#61a874;border-style:solid}.lt{left:22rpx;top:22rpx;border-width:3rpx 0 0 3rpx;border-radius:12rpx 0 0 0}.rt{right:22rpx;top:22rpx;border-width:3rpx 3rpx 0 0;border-radius:0 12rpx 0 0}.lb{left:22rpx;bottom:22rpx;border-width:0 0 3rpx 3rpx;border-radius:0 0 0 12rpx}.rb{right:22rpx;bottom:22rpx;border-width:0 3rpx 3rpx 0;border-radius:0 0 12rpx 0}.camera-icon{width:104rpx;height:104rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;box-shadow:0 14rpx 30rpx rgba(53,111,67,.13)}.lens{width:66rpx;height:66rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e7f3e4;color:#3e9258;font-size:39rpx}.capture-title{font-size:30rpx;font-weight:750;color:#264633;margin-top:19rpx}.capture-sub{font-size:20rpx;color:#8b998f;margin-top:7rpx}.camera-btn{margin-top:19rpx;background:linear-gradient(135deg,#4d9e65,#32824f);color:#fff;border-radius:999rpx;padding:14rpx 31rpx;font-size:23rpx;font-weight:600;box-shadow:0 9rpx 20rpx rgba(52,130,77,.18)}.camera-btn text{margin-left:13rpx}.album-btn{display:flex;align-items:center;gap:17rpx;padding:23rpx 8rpx 12rpx}.album-icon{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:#f0f4ec;color:#3f8554;font-size:31rpx}.album-title{font-size:25rpx;font-weight:650;color:#293c31}.album-sub{font-size:19rpx;color:#a0a8a2;margin-top:3rpx}.album-arrow{font-size:34rpx;color:#a6afa9;margin-left:auto}.privacy-note{text-align:center;font-size:18rpx;color:#a8b0aa;margin:12rpx 0 3rpx}.privacy-note::before{content:'✓';color:#4a9660;margin-right:7rpx}
.diagnose-card{display:flex;align-items:center;gap:18rpx;border:1rpx solid #f0d5a7;background:linear-gradient(135deg,#fffaf0,#fff0d3);border-radius:28rpx;padding:23rpx;margin-top:22rpx;box-shadow:0 10rpx 26rpx rgba(137,91,33,.05)}.diagnose-icon{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:21rpx;background:rgba(255,255,255,.78);color:#b56222;font-size:26rpx;font-weight:700}.diagnose-copy{flex:1}.diag-t{font-size:26rpx;font-weight:700;color:#84421b}.diag-s{font-size:19rpx;color:#b27648;margin-top:5rpx}.diag-go{color:#ba7d4c;font-size:36rpx}
.preview-wrap{height:430rpx;border-radius:27rpx;overflow:hidden;position:relative}.preview{width:100%;height:100%}.scan-line{position:absolute;left:7%;right:7%;height:3rpx;top:50%;background:#68d083;box-shadow:0 0 18rpx #6ee08a}.loading-icon{display:flex;justify-content:center;gap:9rpx;margin-top:27rpx}.loading-icon view{width:12rpx;height:12rpx;border-radius:50%;background:#51a868}.loading-title{text-align:center;font-size:28rpx;font-weight:700;color:#2a5037;margin-top:15rpx}.loading-sub{text-align:center;font-size:20rpx;color:#99a39c;margin-top:6rpx;margin-bottom:6rpx}
.result-card{background:#fff;border-radius:34rpx;padding:28rpx;box-shadow:0 15rpx 38rpx rgba(44,72,51,.09)}.result-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:24rpx;border-bottom:1rpx solid #eef2ed}.result-kicker{font-size:20rpx;color:#4a945f}.result-title{font-size:31rpx;font-weight:800;color:#253d2e;margin-top:4rpx}.confidence{text-align:center;color:#41905a;font-size:21rpx;background:#edf7eb;border-radius:20rpx;padding:12rpx 17rpx}.confidence text{font-size:34rpx;font-weight:800}.confidence view{font-size:16rpx;color:#7c947f;margin-top:-3rpx}.result-main{display:flex;align-items:center;gap:19rpx;padding:29rpx 4rpx 10rpx}.result-leaf{width:82rpx;height:82rpx;border-radius:24rpx;background:linear-gradient(145deg,#e1f2dd,#c6e4c5);display:flex;align-items:center;justify-content:center;color:#388553;font-size:45rpx}.result-copy{flex:1}.species-name{font-size:34rpx;font-weight:800;color:#243b2d}.species-hint{font-size:20rpx;color:#9aa49d;margin-top:6rpx}.result-arrow{font-size:42rpx;color:#91a097}.retry-btn{text-align:center;border:1rpx solid #61a873;color:#3f8d57;background:#fff;border-radius:23rpx;padding:21rpx 0;font-size:26rpx;font-weight:600;margin-top:18rpx}
