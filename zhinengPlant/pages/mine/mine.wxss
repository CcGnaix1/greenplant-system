.mine-page{padding:28rpx 28rpx 54rpx;background:linear-gradient(180deg,#f5f6ef 0%,#faf9f4 52%,#f4f6ef 100%);min-height:100vh;box-sizing:border-box}
.profile-hero{height:370rpx;border-radius:40rpx;background:linear-gradient(135deg,#dcecd6 0%,#b8d9b5 55%,#9fc99f 100%);position:relative;overflow:visible;box-shadow:0 20rpx 44rpx rgba(50,91,57,.13);margin-bottom:84rpx}
.hero-orb{position:absolute;border-radius:50%;background:rgba(255,255,255,.2);overflow:hidden}.orb-one{width:280rpx;height:280rpx;right:0;top:0}.orb-two{width:170rpx;height:170rpx;right:88rpx;bottom:0}
.hero-top{position:relative;z-index:1;display:flex;justify-content:space-between;padding:38rpx 38rpx 0}.profile-eyebrow{font-size:19rpx;letter-spacing:5rpx;color:#568066;font-weight:600}.profile-title{font-size:43rpx;font-weight:800;color:#214a31;margin-top:10rpx}.profile-subtitle{font-size:22rpx;color:#62826b;margin-top:8rpx}.leaf-mark{font-size:86rpx;line-height:1;color:rgba(39,104,59,.32);transform:rotate(-18deg)}
.user-card{position:absolute;z-index:2;left:26rpx;right:26rpx;bottom:-54rpx;min-height:150rpx;box-sizing:border-box;background:rgba(255,255,255,.97);border:1rpx solid rgba(52,100,61,.08);border-radius:34rpx;padding:26rpx 28rpx;display:flex;align-items:center;gap:22rpx;box-shadow:0 18rpx 40rpx rgba(42,73,49,.13)}
.avatar-wrap{position:relative;flex-shrink:0}.avatar{width:100rpx;height:100rpx;border-radius:50%;overflow:hidden;background:linear-gradient(145deg,#e7f5e4,#c8e3c7);color:#2f7b49;display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:800;border:5rpx solid #fff;box-shadow:0 8rpx 22rpx rgba(52,120,72,.13)}.avatar image{width:100%;height:100%}.avatar-edit{position:absolute;right:-3rpx;bottom:1rpx;width:34rpx;height:34rpx;border-radius:50%;background:#4b9b62;border:4rpx solid #fff;display:flex;align-items:center;justify-content:center;box-shadow:0 5rpx 12rpx rgba(43,105,61,.2)}.avatar-edit image{width:21rpx;height:21rpx}.online-dot{position:absolute;right:2rpx;bottom:7rpx;width:20rpx;height:20rpx;border-radius:50%;background:#51ae67;border:5rpx solid #fff}
.who{flex:1;min-width:0}.user-line{display:flex;align-items:center;gap:12rpx}.uname{font-size:34rpx;font-weight:800;color:#21372a}.role-chip{font-size:19rpx;color:#3d8254;background:#e8f4e6;border-radius:999rpx;padding:6rpx 13rpx}.urole{font-size:21rpx;color:#8a978f;margin-top:9rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.login-arrow{font-size:24rpx;color:#3e8d58;font-weight:600}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:0 6rpx 18rpx}.section-title{font-size:32rpx;font-weight:800;color:#20372a}.section-desc{font-size:21rpx;color:#95a098;margin-top:5rpx}.service-count{font-size:20rpx;color:#7b8a80;background:#edf2e9;padding:8rpx 14rpx;border-radius:999rpx}
.service-grid{display:flex;gap:18rpx;margin-bottom:20rpx}.service-card{position:relative;flex:1;height:202rpx;border-radius:30rpx;padding:24rpx;box-sizing:border-box;overflow:hidden;box-shadow:0 12rpx 28rpx rgba(53,77,57,.08)}.service-card.green{background:linear-gradient(145deg,#e5f2e1,#cfe6ce)}.service-card.amber{background:linear-gradient(145deg,#fff3dc,#f8dfb6)}.service-icon{width:58rpx;height:58rpx;border-radius:18rpx;background:rgba(255,255,255,.78);display:flex;align-items:center;justify-content:center;box-shadow:0 7rpx 16rpx rgba(66,104,72,.08)}.service-icon image{width:38rpx;height:38rpx}.service-name{font-size:27rpx;font-weight:750;color:#244031;margin-top:15rpx}.service-note{font-size:19rpx;color:#75857a;margin-top:5rpx;white-space:nowrap}.service-arrow{position:absolute;right:20rpx;top:22rpx;font-size:36rpx;color:rgba(40,74,49,.45)}
.menu-card{background:rgba(255,255,255,.96);border-radius:32rpx;padding:4rpx 24rpx;box-shadow:0 14rpx 34rpx rgba(44,68,49,.07);border:1rpx solid rgba(54,96,68,.07)}.menu-row{display:flex;align-items:center;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid #edf1ec}.menu-row:last-child{border-bottom:none}.menu-icon{width:68rpx;height:68rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.menu-icon image{width:42rpx;height:42rpx}.diagnose{background:#e5f3e4}.timeline{background:#e5eff5}.export{background:#f9ecdc}.menu-main{flex:1;min-width:0}.menu-title{font-size:27rpx;font-weight:650;color:#263a2f}.menu-note{font-size:20rpx;color:#9aa39d;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.go{color:#a7b0aa;font-size:36rpx}.format-chip{font-size:17rpx;color:#738078;background:#f2f4f1;border-radius:999rpx;padding:6rpx 10rpx;white-space:nowrap}
.account-actions{display:flex;gap:18rpx;margin-top:24rpx}.account-btn{flex:1;text-align:center;padding:21rpx 0;border-radius:22rpx;background:#fff;color:#398254;border:1rpx solid #b8d7be;font-size:25rpx;font-weight:600}.account-btn.logout{color:#9a6759;border-color:#e7cec5;background:#fffaf7}.login-btn{text-align:center;padding:23rpx 0;border-radius:22rpx;margin-top:24rpx;background:linear-gradient(135deg,#4c9d65,#318251);color:#fff;font-size:27rpx;font-weight:650;box-shadow:0 12rpx 28rpx rgba(45,126,77,.18)}.footer-copy{text-align:center;font-size:17rpx;letter-spacing:1rpx;color:#b1b8b2;margin:28rpx 0 4rpx}
