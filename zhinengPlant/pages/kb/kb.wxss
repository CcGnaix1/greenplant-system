.kb-hero{display:flex;align-items:center;gap:22rpx;padding:34rpx 30rpx;margin-bottom:34rpx;border-radius:32rpx;background:linear-gradient(135deg,#dfeede,#f3f5e8);box-shadow:0 14rpx 34rpx rgba(54,89,59,.08)}.kb-mark{width:88rpx;height:88rpx;border-radius:28rpx;background:linear-gradient(145deg,#58a46d,#3e8655);display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 22rpx rgba(48,119,70,.18)}.kb-mark image{width:52rpx;height:52rpx}.kb-title{font-size:34rpx;font-weight:800}.kb-sub{font-size:21rpx;color:#79877e;margin-top:7rpx}.section-label{font-size:29rpx;font-weight:750;margin:0 4rpx 18rpx}.go{color:#9ca3af;font-size:36rpx}
.kb-thumb{width:108rpx;height:108rpx;border-radius:24rpx;flex-shrink:0;background:#e8f2e6}
