<view class="page">
  <view class="kb-hero"><view class="kb-mark"><image src="/assets/icons/book.svg" mode="aspectFit" /></view><view><view class="kb-title">绿植养护知识库</view><view class="kb-sub">科学了解习性，轻松照顾植物</view></view></view>
  <view class="section-label">热门植物</view>
  <view wx:for="{{list}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="goDetail">
    <image class="kb-thumb" src="{{item.image}}" mode="aspectFill" />
    <view class="main">
      <view class="t">{{item.name}} <text class="chip blue">{{item.tag}}</text></view>
      <view class="s">{{item.desc}}</view>
    </view>
    <view class="go">›</view>
  </view>
</view>
