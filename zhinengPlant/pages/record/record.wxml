<view class="page">
  <view class="card">
    <view class="card-title">本次操作</view>
    <view class="chip-row">
      <view wx:for="{{types}}" wx:key="*this"
            class="chip {{picked===item ? 'sel' : 'gray'}}"
            data-t="{{item}}" bindtap="onPick">{{item}}</view>
    </view>
  </view>
  <view class="card">
    <view class="field">
      <label>备注（可选）</label>
      <view class="ctrl" style="align-items:flex-start">
        <input value="{{note}}" bindinput="onNote" placeholder="如：浇了约 500ml" />
      </view>
    </view>
  </view>
  <view class="btn" bindtap="submit">保存记录</view>
</view>
