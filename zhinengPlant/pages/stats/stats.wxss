.bars { display: flex; align-items: flex-end; gap: 24rpx; height: 180rpx; padding: 10rpx 10rpx 0; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bar { width: 40rpx; background: #86efac; border-radius: 10rpx 10rpx 0 0; }
.bar-x { font-size: 20rpx; color: #9ca3af; margin-top: 8rpx; }
.hbars { display: flex; align-items: flex-end; gap: 16rpx; height: 260rpx; padding: 10rpx 10rpx 0; }
.h-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.h-val { font-size: 18rpx; color: #4b5563; }
.h-bar { width: 36rpx; background: #16a34a; border-radius: 8rpx 8rpx 0 0; margin-top: 6rpx; }
.h-x { font-size: 20rpx; color: #9ca3af; margin-top: 8rpx; }
