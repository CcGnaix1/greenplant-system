<view class="page">
  <view class="detail-hero">
    <image class="detail-image" src="{{d.image}}" mode="aspectFill" />
    <view class="detail-shade"><view class="detail-name">{{d.name}}</view><view class="detail-sub">{{d.latinName || '绿植养护指南'}}</view></view>
  </view>
  <view class="card">
    <view class="card-title">生长习性</view>
    <view class="p">{{d.habit}}</view>
  </view>

  <view class="card">
    <view class="card-title">四季日历</view>
    <view wx:for="{{d.seasons}}" wx:key="*this" class="season">· {{item}}</view>
  </view>

  <view class="card">
    <view class="card-title">浇水要点</view>
    <view class="p">{{d.water}}</view>
    <view class="card-title" style="margin-top:20rpx">施肥要点</view>
    <view class="p">{{d.fertilize}}</view>
    <view class="card-title" style="margin-top:20rpx">繁殖方法</view>
    <view class="p">{{d.breed}}</view>
  </view>

  <view class="card">
    <view class="card-title">常见问题</view>
    <view wx:for="{{d.faq}}" wx:key="q" class="faq">
      <view class="q">Q：{{item.q}}</view>
      <view class="a">A：{{item.a}}</view>
    </view>
  </view>

  <view class="photo md">养护视频位（接入后展示）</view>
</view>
