<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.greenplant.mapper.UserProfileMapper">
    <!-- 用户头像资料的查询与保存。 -->
    <select id="findById" resultType="com.greenplant.entity.UserProfile">
        SELECT user_id, avatar_url, updated_at FROM user_profile WHERE user_id=#{userId}
    </select>
    <insert id="insert">INSERT INTO user_profile(user_id, avatar_url) VALUES(#{userId}, #{avatarUrl})</insert>
    <update id="update">UPDATE user_profile SET avatar_url=#{avatarUrl} WHERE user_id=#{userId}</update>
</mapper>
