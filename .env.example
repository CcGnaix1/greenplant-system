# 复制本文件为 .env 后填写。不要把填写后的 .env 发给别人或提交到 Git。

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=greenplant
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# 微信小程序（从微信公众平台获取；AppSecret 只能保存在后端）
WECHAT_APPID=
WECHAT_APP_SECRET=

# JWT 签名密钥（接收项目的人应自行生成一个足够长的随机字符串）
JWT_SECRET=

# 服务端口与本地 AI
SERVER_PORT=8081
AI_BASE_URL=http://127.0.0.1:5001

# 当前未使用；恢复 Plant.id 时再填写
PLANT_ID_API_KEY=
